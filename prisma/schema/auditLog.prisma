model AuditLog {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id])

  action     AuditAction
  entityType String // e.g. "ServiceRequest", "User", "Payment"
  entityId   String

  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation("AuditServiceRequest", fields: [serviceRequestId], references: [id])

  metadata Json? // e.g. { from: "PENDING", to: "ASSIGNED" }

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
